diff --git a/Source/engine/render/gl1/gl1_hd_dump.cpp b/Source/engine/render/gl1/gl1_hd_dump.cpp
new file mode 100644
index 0000000..c20cb23
--- /dev/null
+++ b/Source/engine/render/gl1/gl1_hd_dump.cpp
@@ -0,0 +1,79 @@
+#include "engine/render/gl1/gl1_hd_dump.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+#ifdef USE_SDL3
+#include <SDL3/SDL_iostream.h>
+#endif
+
+#include "engine/surface.hpp"
+#include "utils/file_util.h"
+#include "utils/sdl_compat.h"
+#include "utils/sdl_wrap.h"
+#include "utils/str_cat.hpp"
+#include "utils/surface_to_png.hpp"
+
+namespace devilution {
+
+HdDumper::HdDumper(std::string dir)
+    : dir_(std::move(dir))
+{
+	while (!dir_.empty() && (dir_.back() == '/' || dir_.back() == '\\'))
+		dir_.pop_back();
+}
+
+std::string HdDumper::DirFromEnvironment()
+{
+	const char *dir = std::getenv("DVX_HD_DUMP");
+	return dir != nullptr ? std::string(dir) : std::string();
+}
+
+bool HdDumper::Dump(const HdKey &key, const HdIndexedFrame &frame, const std::array<SDL_Color, 256> &palette, const HdDumpInfo &info)
+{
+	if (!enabled() || frame.width == 0 || frame.height == 0)
+		return false;
+	const std::string hex = HdKeyToHex(key);
+	if (!dumped_.insert(hex).second)
+		return false;
+
+	const std::string subdir = StrCat(dir_, DIRECTORY_SEPARATOR_STR "1x" DIRECTORY_SEPARATOR_STR, hex.substr(0, 2));
+	const std::string path = StrCat(subdir, DIRECTORY_SEPARATOR_STR, hex, ".png");
+	if (FileExists(path))
+		return false;
+	RecursivelyCreateDir(subdir.c_str());
+
+	std::vector<uint8_t> rgba(frame.pixels.size() * 4, 0);
+	for (size_t i = 0; i < frame.pixels.size(); ++i) {
+		const uint16_t pixel = frame.pixels[i];
+		if (pixel == HdTransparentPixel)
+			continue;
+		const SDL_Color &color = palette[pixel];
+		rgba[i * 4 + 0] = color.r;
+		rgba[i * 4 + 1] = color.g;
+		rgba[i * 4 + 2] = color.b;
+		rgba[i * 4 + 3] = 255;
+	}
+	const SDLSurfaceUniquePtr surface = SDLWrap::CreateRGBSurfaceWithFormatFrom(
+	    rgba.data(), frame.width, frame.height, 32, frame.width * 4, SDL_PIXELFORMAT_RGBA32);
+	if (!WriteSurfaceToFilePng(Surface(surface.get()), SDL_IOFromFile(path.c_str(), "wb")).has_value())
+		return false;
+
+	const std::string manifestPath = StrCat(dir_, DIRECTORY_SEPARATOR_STR "manifest.tsv");
+	const bool newManifest = !FileExists(manifestPath);
+	FILE *manifest = OpenFile(manifestPath.c_str(), "ab");
+	if (manifest != nullptr) {
+		if (newManifest) {
+			constexpr std::string_view Header = "key\tkind\twidth\theight\ttile_type\ttrn\tlevel_type\n";
+			std::fwrite(Header.data(), 1, Header.size(), manifest);
+		}
+		const std::string line = StrCat(hex, "\t", info.kind, "\t", frame.width, "\t", frame.height, "\t",
+		    info.tileType, "\t", info.trn ? "trn" : "none", "\t", info.levelType, "\n");
+		std::fwrite(line.data(), 1, line.size(), manifest);
+		std::fclose(manifest);
+	}
+	return true;
+}
+
+} // namespace devilution
diff --git a/Source/engine/render/gl1/gl1_hd_dump.hpp b/Source/engine/render/gl1/gl1_hd_dump.hpp
new file mode 100644
index 0000000..4ba9a74
--- /dev/null
+++ b/Source/engine/render/gl1/gl1_hd_dump.hpp
@@ -0,0 +1,59 @@
+/**
+ * @file gl1_hd_dump.hpp
+ *
+ * Dump mode for building HD packs: with `DVX_HD_DUMP=<dir>` set, every sprite and tile frame
+ * the GL1 renderer uploads is written once as `<dir>/1x/<kk>/<key>.png`, and a line is added
+ * to `<dir>/manifest.tsv`. These are exactly the frames, and keys, the HD loader looks up.
+ */
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <unordered_set>
+
+#ifdef USE_SDL3
+#include <SDL3/SDL_pixels.h>
+#else
+#include <SDL.h>
+#endif
+
+#include "engine/render/gl1/gl1_hd_key.hpp"
+
+namespace devilution {
+
+/** @brief What a dumped frame is, for `manifest.tsv`. */
+struct HdDumpInfo {
+	/** "sprite" or "tile". */
+	std::string_view kind;
+	/** Tile type number (`TileType`), or -1 for sprites. */
+	int tileType = -1;
+	/** Whether a TRN (colour translation) was applied. */
+	bool trn = false;
+	/** `dungeon_type` of the current level. */
+	int levelType = 0;
+};
+
+class HdDumper {
+public:
+	/** @brief Dumps into `dir`; an empty `dir` disables dumping. */
+	explicit HdDumper(std::string dir);
+
+	/** @brief Directory from the `DVX_HD_DUMP` environment variable (empty if unset). */
+	static std::string DirFromEnvironment();
+
+	[[nodiscard]] bool enabled() const { return !dir_.empty(); }
+
+	/**
+	 * @brief Writes the frame (once per key) as straight-alpha RGBA PNG, colours from `palette`.
+	 * @return true if a new file was written.
+	 */
+	bool Dump(const HdKey &key, const HdIndexedFrame &frame, const std::array<SDL_Color, 256> &palette, const HdDumpInfo &info);
+
+private:
+	std::string dir_;
+	std::unordered_set<std::string> dumped_;
+};
+
+} // namespace devilution
diff --git a/Source/engine/render/gl1/gl1_hd_json.cpp b/Source/engine/render/gl1/gl1_hd_json.cpp
new file mode 100644
index 0000000..b8d758d
--- /dev/null
+++ b/Source/engine/render/gl1/gl1_hd_json.cpp
@@ -0,0 +1,346 @@
+#include "engine/render/gl1/gl1_hd_json.hpp"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+
+namespace devilution {
+
+namespace {
+
+constexpr int MaxDepth = 64;
+
+class Parser {
+public:
+	explicit Parser(std::string_view text)
+	    : text_(text)
+	{
+	}
+
+	std::optional<HdJsonValue> ParseDocument()
+	{
+		SkipWhitespace();
+		std::optional<HdJsonValue> value = ParseValue(0);
+		if (!value)
+			return std::nullopt;
+		SkipWhitespace();
+		if (pos_ != text_.size())
+			return Fail("trailing characters");
+		return value;
+	}
+
+	std::string error;
+
+private:
+	std::nullopt_t Fail(const char *message)
+	{
+		if (error.empty())
+			error = std::string(message) + " at offset " + std::to_string(pos_);
+		return std::nullopt;
+	}
+
+	void SkipWhitespace()
+	{
+		while (pos_ < text_.size() && (text_[pos_] == ' ' || text_[pos_] == '\t' || text_[pos_] == '\n' || text_[pos_] == '\r'))
+			++pos_;
+	}
+
+	bool Consume(std::string_view literal)
+	{
+		if (text_.substr(pos_, literal.size()) != literal)
+			return false;
+		pos_ += literal.size();
+		return true;
+	}
+
+	std::optional<HdJsonValue> ParseValue(int depth)
+	{
+		if (depth > MaxDepth)
+			return Fail("nesting too deep");
+		if (pos_ >= text_.size())
+			return Fail("unexpected end");
+		switch (text_[pos_]) {
+		case '{':
+			return ParseObject(depth);
+		case '[':
+			return ParseArray(depth);
+		case '"': {
+			std::optional<std::string> str = ParseString();
+			if (!str)
+				return std::nullopt;
+			return HdJsonValue::MakeString(std::move(*str));
+		}
+		case 't':
+			if (Consume("true"))
+				return HdJsonValue::MakeBool(true);
+			break;
+		case 'f':
+			if (Consume("false"))
+				return HdJsonValue::MakeBool(false);
+			break;
+		case 'n':
+			if (Consume("null"))
+				return HdJsonValue::MakeNull();
+			break;
+		default:
+			return ParseNumber();
+		}
+		return Fail("invalid literal");
+	}
+
+	std::optional<HdJsonValue> ParseObject(int depth)
+	{
+		++pos_; // '{'
+		HdJsonValue::Object members;
+		SkipWhitespace();
+		if (pos_ < text_.size() && text_[pos_] == '}') {
+			++pos_;
+			return HdJsonValue::MakeObject(std::move(members));
+		}
+		while (true) {
+			SkipWhitespace();
+			if (pos_ >= text_.size() || text_[pos_] != '"')
+				return Fail("expected member name");
+			std::optional<std::string> name = ParseString();
+			if (!name)
+				return std::nullopt;
+			SkipWhitespace();
+			if (!Consume(":"))
+				return Fail("expected ':'");
+			SkipWhitespace();
+			std::optional<HdJsonValue> value = ParseValue(depth + 1);
+			if (!value)
+				return std::nullopt;
+			members.emplace_back(std::move(*name), std::move(*value));
+			SkipWhitespace();
+			if (Consume("}"))
+				return HdJsonValue::MakeObject(std::move(members));
+			if (!Consume(","))
+				return Fail("expected ',' or '}'");
+		}
+	}
+
+	std::optional<HdJsonValue> ParseArray(int depth)
+	{
+		++pos_; // '['
+		HdJsonValue::Array elements;
+		SkipWhitespace();
+		if (Consume("]"))
+			return HdJsonValue::MakeArray(std::move(elements));
+		while (true) {
+			SkipWhitespace();
+			std::optional<HdJsonValue> value = ParseValue(depth + 1);
+			if (!value)
+				return std::nullopt;
+			elements.push_back(std::move(*value));
+			SkipWhitespace();
+			if (Consume("]"))
+				return HdJsonValue::MakeArray(std::move(elements));
+			if (!Consume(","))
+				return Fail("expected ',' or ']'");
+		}
+	}
+
+	std::optional<uint32_t> ParseHex4()
+	{
+		if (pos_ + 4 > text_.size())
+			return std::nullopt;
+		uint32_t value = 0;
+		for (int i = 0; i < 4; ++i) {
+			const char c = text_[pos_++];
+			value <<= 4;
+			if (c >= '0' && c <= '9')
+				value |= c - '0';
+			else if (c >= 'a' && c <= 'f')
+				value |= c - 'a' + 10;
+			else if (c >= 'A' && c <= 'F')
+				value |= c - 'A' + 10;
+			else
+				return std::nullopt;
+		}
+		return value;
+	}
+
+	static void AppendUtf8(std::string &out, uint32_t cp)
+	{
+		if (cp < 0x80) {
+			out += static_cast<char>(cp);
+		} else if (cp < 0x800) {
+			out += static_cast<char>(0xC0 | (cp >> 6));
+			out += static_cast<char>(0x80 | (cp & 0x3F));
+		} else if (cp < 0x10000) {
+			out += static_cast<char>(0xE0 | (cp >> 12));
+			out += static_cast<char>(0x80 | ((cp >> 6) & 0x3F));
+			out += static_cast<char>(0x80 | (cp & 0x3F));
+		} else {
+			out += static_cast<char>(0xF0 | (cp >> 18));
+			out += static_cast<char>(0x80 | ((cp >> 12) & 0x3F));
+			out += static_cast<char>(0x80 | ((cp >> 6) & 0x3F));
+			out += static_cast<char>(0x80 | (cp & 0x3F));
+		}
+	}
+
+	std::optional<std::string> ParseString()
+	{
+		++pos_; // '"'
+		std::string out;
+		while (true) {
+			if (pos_ >= text_.size())
+				return Fail("unterminated string");
+			const char c = text_[pos_++];
+			if (c == '"')
+				return out;
+			if (static_cast<unsigned char>(c) < 0x20)
+				return Fail("control character in string");
+			if (c != '\\') {
+				out += c;
+				continue;
+			}
+			if (pos_ >= text_.size())
+				return Fail("unterminated escape");
+			const char e = text_[pos_++];
+			switch (e) {
+			case '"': out += '"'; break;
+			case '\\': out += '\\'; break;
+			case '/': out += '/'; break;
+			case 'b': out += '\b'; break;
+			case 'f': out += '\f'; break;
+			case 'n': out += '\n'; break;
+			case 'r': out += '\r'; break;
+			case 't': out += '\t'; break;
+			case 'u': {
+				std::optional<uint32_t> cp = ParseHex4();
+				if (!cp)
+					return Fail("invalid \\u escape");
+				if (*cp >= 0xD800 && *cp <= 0xDBFF) {
+					if (!Consume("\\u"))
+						return Fail("unpaired surrogate");
+					std::optional<uint32_t> low = ParseHex4();
+					if (!low || *low < 0xDC00 || *low > 0xDFFF)
+						return Fail("unpaired surrogate");
+					*cp = 0x10000 + ((*cp - 0xD800) << 10) + (*low - 0xDC00);
+				} else if (*cp >= 0xDC00 && *cp <= 0xDFFF) {
+					return Fail("unpaired surrogate");
+				}
+				AppendUtf8(out, *cp);
+				break;
+			}
+			default:
+				return Fail("invalid escape");
+			}
+		}
+	}
+
+	std::optional<HdJsonValue> ParseNumber()
+	{
+		const size_t start = pos_;
+		const auto digits = [&]() {
+			const size_t from = pos_;
+			while (pos_ < text_.size() && text_[pos_] >= '0' && text_[pos_] <= '9')
+				++pos_;
+			return pos_ > from;
+		};
+		if (pos_ < text_.size() && text_[pos_] == '-')
+			++pos_;
+		if (pos_ < text_.size() && text_[pos_] == '0') {
+			++pos_;
+		} else if (!digits()) {
+			return Fail("invalid value");
+		}
+		if (pos_ < text_.size() && text_[pos_] == '.') {
+			++pos_;
+			if (!digits())
+				return Fail("invalid number");
+		}
+		if (pos_ < text_.size() && (text_[pos_] == 'e' || text_[pos_] == 'E')) {
+			++pos_;
+			if (pos_ < text_.size() && (text_[pos_] == '+' || text_[pos_] == '-'))
+				++pos_;
+			if (!digits())
+				return Fail("invalid number");
+		}
+		const std::string number(text_.substr(start, pos_ - start));
+		return HdJsonValue::MakeNumber(std::strtod(number.c_str(), nullptr));
+	}
+
+	std::string_view text_;
+	size_t pos_ = 0;
+};
+
+} // namespace
+
+const HdJsonValue *HdJsonValue::Find(std::string_view key) const
+{
+	if (type_ != Type::Object)
+		return nullptr;
+	for (const auto &[name, value] : object_) {
+		if (name == key)
+			return &value;
+	}
+	return nullptr;
+}
+
+std::optional<int> HdJsonValue::GetInt(std::string_view key, int min, int max) const
+{
+	const HdJsonValue *value = Find(key);
+	if (value == nullptr || !value->IsNumber())
+		return std::nullopt;
+	const double number = value->AsNumber();
+	if (number != std::floor(number) || number < min || number > max)
+		return std::nullopt;
+	return static_cast<int>(number);
+}
+
+std::optional<std::string_view> HdJsonValue::GetString(std::string_view key) const
+{
+	const HdJsonValue *value = Find(key);
+	if (value == nullptr || !value->IsString())
+		return std::nullopt;
+	return std::string_view(value->AsString());
+}
+
+HdJsonValue HdJsonValue::MakeBool(bool value)
+{
+	HdJsonValue result(Type::Bool);
+	result.bool_ = value;
+	return result;
+}
+
+HdJsonValue HdJsonValue::MakeNumber(double value)
+{
+	HdJsonValue result(Type::Number);
+	result.number_ = value;
+	return result;
+}
+
+HdJsonValue HdJsonValue::MakeString(std::string value)
+{
+	HdJsonValue result(Type::String);
+	result.string_ = std::move(value);
+	return result;
+}
+
+HdJsonValue HdJsonValue::MakeArray(Array value)
+{
+	HdJsonValue result(Type::Array);
+	result.array_ = std::move(value);
+	return result;
+}
+
+HdJsonValue HdJsonValue::MakeObject(Object value)
+{
+	HdJsonValue result(Type::Object);
+	result.object_ = std::move(value);
+	return result;
+}
+
+std::optional<HdJsonValue> ParseHdJson(std::string_view text, std::string *error)
+{
+	Parser parser(text);
+	std::optional<HdJsonValue> result = parser.ParseDocument();
+	if (!result && error != nullptr)
+		*error = parser.error;
+	return result;
+}
+
+} // namespace devilution
diff --git a/Source/engine/render/gl1/gl1_hd_json.hpp b/Source/engine/render/gl1/gl1_hd_json.hpp
new file mode 100644
index 0000000..6fa3fdb
--- /dev/null
+++ b/Source/engine/render/gl1/gl1_hd_json.hpp
@@ -0,0 +1,78 @@
+/**
+ * @file gl1_hd_json.hpp
+ *
+ * A small JSON reader for HD pack manifests (RFC 8259, UTF-8, no extensions).
+ */
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace devilution {
+
+class HdJsonValue {
+public:
+	enum class Type : uint8_t {
+		Null,
+		Bool,
+		Number,
+		String,
+		Array,
+		Object,
+	};
+
+	using Array = std::vector<HdJsonValue>;
+	using Object = std::vector<std::pair<std::string, HdJsonValue>>;
+
+	[[nodiscard]] Type type() const { return type_; }
+	[[nodiscard]] bool IsNumber() const { return type_ == Type::Number; }
+	[[nodiscard]] bool IsString() const { return type_ == Type::String; }
+	[[nodiscard]] bool IsArray() const { return type_ == Type::Array; }
+	[[nodiscard]] bool IsObject() const { return type_ == Type::Object; }
+
+	[[nodiscard]] bool AsBool() const { return bool_; }
+	[[nodiscard]] double AsNumber() const { return number_; }
+	[[nodiscard]] const std::string &AsString() const { return string_; }
+	[[nodiscard]] const Array &AsArray() const { return array_; }
+	[[nodiscard]] const Object &AsObject() const { return object_; }
+
+	/** @brief Member of an object, or null if absent or not an object. */
+	[[nodiscard]] const HdJsonValue *Find(std::string_view key) const;
+
+	/** @brief Integer member, if present and a whole number in [min, max]. */
+	[[nodiscard]] std::optional<int> GetInt(std::string_view key, int min, int max) const;
+	[[nodiscard]] std::optional<std::string_view> GetString(std::string_view key) const;
+
+	static HdJsonValue MakeNull() { return HdJsonValue(Type::Null); }
+	static HdJsonValue MakeBool(bool value);
+	static HdJsonValue MakeNumber(double value);
+	static HdJsonValue MakeString(std::string value);
+	static HdJsonValue MakeArray(Array value);
+	static HdJsonValue MakeObject(Object value);
+
+private:
+	explicit HdJsonValue(Type type)
+	    : type_(type)
+	{
+	}
+
+	Type type_;
+	bool bool_ = false;
+	double number_ = 0;
+	std::string string_;
+	Array array_;
+	Object object_;
+};
+
+/**
+ * @brief Parses a complete JSON document.
+ * @param error Set to a short description on failure.
+ */
+std::optional<HdJsonValue> ParseHdJson(std::string_view text, std::string *error = nullptr);
+
+} // namespace devilution
diff --git a/Source/engine/render/gl1/gl1_hd_key.cpp b/Source/engine/render/gl1/gl1_hd_key.cpp
new file mode 100644
index 0000000..46887ac
--- /dev/null
+++ b/Source/engine/render/gl1/gl1_hd_key.cpp
@@ -0,0 +1,199 @@
+#include "engine/render/gl1/gl1_hd_key.hpp"
+
+#include <algorithm>
+
+#include <picosha2.h>
+
+#include "utils/clx_decode.hpp"
+
+namespace devilution {
+
+namespace {
+
+constexpr char HexDigits[] = "0123456789abcdef";
+
+void SetPixel(HdIndexedFrame &frame, int x, int y, uint8_t index)
+{
+	if (x < 0 || x >= frame.width || y < 0 || y >= frame.height)
+		return;
+	frame.pixels[static_cast<size_t>(y) * frame.width + x] = index;
+}
+
+HdIndexedFrame MakeTransparentFrame(int width, int height)
+{
+	HdIndexedFrame frame;
+	frame.width = static_cast<uint16_t>(width);
+	frame.height = static_cast<uint16_t>(height);
+	frame.pixels.assign(static_cast<size_t>(width) * height, HdTransparentPixel);
+	return frame;
+}
+
+int HexValue(char c)
+{
+	if (c >= '0' && c <= '9') return c - '0';
+	if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+	if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+	return -1;
+}
+
+} // namespace
+
+HdIndexedFrame DecodeClxToIndexed(ClxSprite clx, const uint8_t *trn)
+{
+	const int width = clx.width();
+	const int height = clx.height();
+	HdIndexedFrame frame = MakeTransparentFrame(width, height);
+
+	const uint8_t *src = clx.pixelData();
+	const uint8_t *const srcEnd = src + clx.pixelDataSize();
+
+	// CLX rows are stored bottom to top; commands may span rows.
+	int row = height - 1;
+	int x = 0;
+	const auto put = [&](uint8_t index) {
+		SetPixel(frame, x, row, trn != nullptr ? trn[index] : index);
+		++x;
+	};
+	while (src < srcEnd && row >= 0) {
+		const uint8_t v = *src++;
+		if (!IsClxOpaque(v)) {
+			x += v;
+		} else if (IsClxOpaqueFill(v)) {
+			const uint8_t fillWidth = GetClxOpaqueFillWidth(v);
+			if (src >= srcEnd)
+				break;
+			const uint8_t index = *src++;
+			for (int i = 0; i < fillWidth; ++i)
+				put(index);
+		} else {
+			const uint8_t runLength = GetClxOpaquePixelsWidth(v);
+			for (int i = 0; i < runLength && src < srcEnd; ++i)
+				put(*src++);
+		}
+		while (x >= width && row >= 0) {
+			x -= width;
+			--row;
+		}
+	}
+	return frame;
+}
+
+HdIndexedFrame DecodeDunTileToIndexed(const uint8_t *frameData, TileType tileType, int height)
+{
+	constexpr int Width = DunFrameWidth;
+	constexpr int XStep = 2;
+	constexpr int LowerHeight = DunFrameHeight / 2;
+	constexpr int TriangleUpperHeight = (DunFrameHeight / 2) - 1;
+	constexpr int TrapezoidUpperHeight = DunFrameHeight / 2;
+
+	HdIndexedFrame frame = MakeTransparentFrame(Width, height);
+	const uint8_t *src = frameData;
+	int row = height - 1; // Tile data is stored bottom to top.
+
+	const auto copyRow = [&](int startX, int rowWidth) {
+		for (int x = 0; x < rowWidth; ++x)
+			SetPixel(frame, startX + x, row, *src++);
+		--row;
+	};
+
+	switch (tileType) {
+	case TileType::Square:
+		for (int i = 0; i < height; ++i)
+			copyRow(0, Width);
+		break;
+	case TileType::TransparentSquare:
+		for (int i = 0; i < height; ++i) {
+			int x = 0;
+			while (x < Width) {
+				const auto run = static_cast<int8_t>(*src++);
+				if (run < 0) {
+					x -= run;
+					continue;
+				}
+				for (int j = 0; j < run; ++j)
+					SetPixel(frame, x++, row, *src++);
+			}
+			--row;
+		}
+		break;
+	case TileType::LeftTriangle:
+		for (int i = 0; i < LowerHeight; ++i)
+			copyRow(Width - XStep * (i + 1), XStep * (i + 1));
+		for (int i = 0; i < TriangleUpperHeight; ++i)
+			copyRow(XStep * (i + 1), Width - XStep * (i + 1));
+		break;
+	case TileType::RightTriangle:
+		for (int i = 0; i < LowerHeight; ++i)
+			copyRow(0, XStep * (i + 1));
+		for (int i = 0; i < TriangleUpperHeight; ++i)
+			copyRow(0, Width - XStep * (i + 1));
+		break;
+	case TileType::LeftTrapezoid:
+		for (int i = 0; i < LowerHeight; ++i)
+			copyRow(Width - XStep * (i + 1), XStep * (i + 1));
+		for (int i = 0; i < TrapezoidUpperHeight; ++i)
+			copyRow(0, Width);
+		break;
+	case TileType::RightTrapezoid:
+		for (int i = 0; i < LowerHeight; ++i)
+			copyRow(0, XStep * (i + 1));
+		for (int i = 0; i < TrapezoidUpperHeight; ++i)
+			copyRow(0, Width);
+		break;
+	}
+	return frame;
+}
+
+HdKey ComputeHdKey(const HdIndexedFrame &frame)
+{
+	std::vector<uint8_t> message;
+	message.reserve(4 + frame.pixels.size() * 2);
+	const auto putU16 = [&](uint16_t value) {
+		message.push_back(static_cast<uint8_t>(value & 0xFF));
+		message.push_back(static_cast<uint8_t>(value >> 8));
+	};
+	putU16(frame.width);
+	putU16(frame.height);
+	for (const uint16_t pixel : frame.pixels)
+		putU16(pixel);
+
+	HdKey key;
+	picosha2::hash256(message.begin(), message.end(), key.begin(), key.end());
+	return key;
+}
+
+std::string HdKeyToHex(const HdKey &key)
+{
+	std::string hex;
+	hex.reserve(key.size() * 2);
+	for (const uint8_t byte : key) {
+		hex += HexDigits[byte >> 4];
+		hex += HexDigits[byte & 0xF];
+	}
+	return hex;
+}
+
+std::optional<HdKey> HdKeyFromHex(std::string_view hex)
+{
+	HdKey key;
+	if (hex.size() != key.size() * 2)
+		return std::nullopt;
+	for (size_t i = 0; i < key.size(); ++i) {
+		const int hi = HexValue(hex[2 * i]);
+		const int lo = HexValue(hex[2 * i + 1]);
+		if (hi < 0 || lo < 0)
+			return std::nullopt;
+		key[i] = static_cast<uint8_t>((hi << 4) | lo);
+	}
+	return key;
+}
+
+bool UsesAnimatedIndices(const HdIndexedFrame &frame, HdAnimatedRange range)
+{
+	if (range.first > range.last)
+		return false;
+	return std::any_of(frame.pixels.begin(), frame.pixels.end(),
+	    [range](uint16_t pixel) { return range.Contains(pixel); });
+}
+
+} // namespace devilution
diff --git a/Source/engine/render/gl1/gl1_hd_key.hpp b/Source/engine/render/gl1/gl1_hd_key.hpp
new file mode 100644
index 0000000..22a038b
--- /dev/null
+++ b/Source/engine/render/gl1/gl1_hd_key.hpp
@@ -0,0 +1,78 @@
+/**
+ * @file gl1_hd_key.hpp
+ *
+ * Content keys for HD texture packs.
+ *
+ * An HD texture replaces one 1x sprite frame or dungeon tile frame. It is found by a key
+ * computed from the frame's palette indices, so it does not depend on the asset path
+ * (a `ClxSprite` does not know it) and recoloured (TRN) variants get their own keys.
+ *
+ * Key = SHA-256 over: width (u16 LE), height (u16 LE), then every pixel in row-major
+ * order from the top-left corner as u16 LE: the palette index after TRN, or 0x0100 for a
+ * transparent pixel. See docs/hd-pack-format.md.
+ */
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "engine/clx_sprite.hpp"
+#include "levels/dun_tile.hpp"
+
+namespace devilution {
+
+/** @brief Pixel value of a transparent pixel in an indexed HD frame. */
+constexpr uint16_t HdTransparentPixel = 0x0100;
+
+/** @brief A frame decoded to palette indices (or `HdTransparentPixel`), top-down. */
+struct HdIndexedFrame {
+	uint16_t width = 0;
+	uint16_t height = 0;
+	std::vector<uint16_t> pixels;
+
+	[[nodiscard]] bool IsOpaque(int x, int y) const
+	{
+		return pixels[static_cast<size_t>(y) * width + x] != HdTransparentPixel;
+	}
+};
+
+using HdKey = std::array<uint8_t, 32>;
+
+/** @brief Decodes a CLX sprite frame, applying `trn` (may be null) to every opaque pixel. */
+HdIndexedFrame DecodeClxToIndexed(ClxSprite clx, const uint8_t *trn);
+
+/**
+ * @brief Decodes a dungeon tile frame (level CEL micro-tile) as the GL1 renderer draws it:
+ * 32 pixels wide, `height` rows, pixels outside the tile's shape are transparent.
+ */
+HdIndexedFrame DecodeDunTileToIndexed(const uint8_t *frameData, TileType tileType, int height);
+
+HdKey ComputeHdKey(const HdIndexedFrame &frame);
+
+/** @brief 64 lowercase hex digits. */
+std::string HdKeyToHex(const HdKey &key);
+std::optional<HdKey> HdKeyFromHex(std::string_view hex);
+
+/**
+ * @brief Palette indices that colour cycling animates on the current level, as an inclusive
+ * range. `first > last` means none.
+ */
+struct HdAnimatedRange {
+	uint8_t first = 1;
+	uint8_t last = 0;
+
+	[[nodiscard]] bool Contains(uint16_t pixel) const
+	{
+		return pixel >= first && pixel <= last;
+	}
+};
+
+/** @brief Whether any opaque pixel of the frame uses an animated palette index. */
+bool UsesAnimatedIndices(const HdIndexedFrame &frame, HdAnimatedRange range);
+
+} // namespace devilution
diff --git a/Source/engine/render/gl1/gl1_hd_pack.cpp b/Source/engine/render/gl1/gl1_hd_pack.cpp
new file mode 100644
index 0000000..0661926
--- /dev/null
+++ b/Source/engine/render/gl1/gl1_hd_pack.cpp
@@ -0,0 +1,260 @@
+#include "engine/render/gl1/gl1_hd_pack.hpp"
+
+#include <algorithm>
+#include <cstdio>
+
+#include <webp/decode.h>
+
+#include "engine/render/gl1/gl1_hd_json.hpp"
+#include "utils/file_util.h"
+
+namespace devilution {
+
+namespace {
+
+constexpr std::string_view ManifestName = "manifest.json";
+
+void SetError(std::string *error, std::string message)
+{
+	if (error != nullptr)
+		*error = std::move(message);
+}
+
+std::optional<std::vector<uint8_t>> ReadWholeFile(const std::string &path)
+{
+	FILE *file = OpenFile(path.c_str(), "rb");
+	if (file == nullptr)
+		return std::nullopt;
+	std::vector<uint8_t> data;
+	uint8_t buffer[65536];
+	size_t count;
+	while ((count = std::fread(buffer, 1, sizeof(buffer), file)) > 0)
+		data.insert(data.end(), buffer, buffer + count);
+	const bool failed = std::ferror(file) != 0;
+	std::fclose(file);
+	if (failed)
+		return std::nullopt;
+	return data;
+}
+
+/** @brief Pack-relative POSIX path -> native path, or nullopt if it could escape the pack. */
+std::optional<std::string> ResolveImagePath(std::string_view file, const std::string &baseDir)
+{
+	if (file.empty() || file.front() == '/' || file.find('\\') != std::string_view::npos || file.find(':') != std::string_view::npos)
+		return std::nullopt;
+	std::string result = baseDir;
+	size_t start = 0;
+	while (start <= file.size()) {
+		size_t end = file.find('/', start);
+		if (end == std::string_view::npos)
+			end = file.size();
+		const std::string_view part = file.substr(start, end - start);
+		if (part.empty() || part == "." || part == "..")
+			return std::nullopt;
+		result += DIRECTORY_SEPARATOR_STR;
+		result.append(part);
+		start = end + 1;
+	}
+	return result;
+}
+
+void CollectManifests(const std::string &dir, std::vector<std::string> &out, int depth)
+{
+	if (depth > 16)
+		return;
+	for (const std::string &file : ListFiles(dir.c_str())) {
+		if (file == ManifestName)
+			out.push_back(dir);
+	}
+	std::vector<std::string> subdirs = ListDirectories(dir.c_str());
+	std::sort(subdirs.begin(), subdirs.end());
+	for (const std::string &subdir : subdirs)
+		CollectManifests(dir + DIRECTORY_SEPARATOR_STR + subdir, out, depth + 1);
+}
+
+} // namespace
+
+void HdPackIndex::AddPacksIn(const std::string &packsRoot)
+{
+	if (!DirectoryExists(packsRoot))
+		return;
+	std::vector<std::string> packs = ListDirectories(packsRoot.c_str());
+	std::sort(packs.begin(), packs.end());
+	for (const std::string &pack : packs)
+		AddPack(packsRoot + DIRECTORY_SEPARATOR_STR + pack);
+}
+
+void HdPackIndex::AddPack(const std::string &packDir)
+{
+	std::vector<std::string> manifestDirs;
+	CollectManifests(packDir, manifestDirs, 0);
+	for (const std::string &dir : manifestDirs) {
+		const std::string manifestPath = dir + DIRECTORY_SEPARATOR_STR + std::string(ManifestName);
+		std::optional<std::vector<uint8_t>> data = ReadWholeFile(manifestPath);
+		if (!data)
+			continue;
+		const std::string_view json(reinterpret_cast<const char *>(data->data()), data->size());
+		AddManifest(json, dir);
+	}
+}
+
+std::optional<size_t> HdPackIndex::AddManifest(std::string_view json, const std::string &baseDir, std::string *error)
+{
+	std::string parseError;
+	std::optional<HdJsonValue> root = ParseHdJson(json, &parseError);
+	if (!root || !root->IsObject()) {
+		SetError(error, root ? "manifest is not an object" : parseError);
+		return std::nullopt;
+	}
+	const std::optional<int> scale = root->GetInt("scale", 1, 64);
+	if (scale != HdPackScale) {
+		SetError(error, "unsupported scale (only 4 is supported)");
+		return std::nullopt;
+	}
+	const HdJsonValue *frames = root->Find("frames");
+	if (frames == nullptr || !frames->IsArray()) {
+		SetError(error, "missing frames");
+		return std::nullopt;
+	}
+
+	size_t added = 0;
+	for (const HdJsonValue &frame : frames->AsArray()) {
+		const std::optional<std::string_view> sha = frame.GetString("sha256");
+		const std::optional<std::string_view> file = frame.GetString("file");
+		const std::optional<int> width = frame.GetInt("width", 1, 4096);
+		const std::optional<int> height = frame.GetInt("height", 1, 4096);
+		if (!sha || !file || !width || !height)
+			continue;
+		const std::optional<HdKey> key = HdKeyFromHex(*sha);
+		const std::optional<std::string> path = ResolveImagePath(*file, baseDir);
+		if (!key || !path)
+			continue;
+
+		HdPackEntry entry;
+		entry.path = *path;
+		entry.width = static_cast<uint16_t>(*width);
+		entry.height = static_cast<uint16_t>(*height);
+		entry.bboxWidth = *width * HdPackScale;
+		entry.bboxHeight = *height * HdPackScale;
+		if (const HdJsonValue *bbox = frame.Find("bbox"); bbox != nullptr) {
+			if (!bbox->IsArray() || bbox->AsArray().size() != 4)
+				continue;
+			int values[4];
+			bool valid = true;
+			for (size_t i = 0; i < 4; ++i) {
+				const HdJsonValue &v = bbox->AsArray()[i];
+				valid = valid && v.IsNumber() && v.AsNumber() >= 0 && v.AsNumber() <= 65536;
+				values[i] = valid ? static_cast<int>(v.AsNumber()) : 0;
+			}
+			if (!valid)
+				continue;
+			entry.bboxX = values[0];
+			entry.bboxY = values[1];
+			entry.bboxWidth = values[2];
+			entry.bboxHeight = values[3];
+		}
+		if (entries_.try_emplace(*key, std::move(entry)).second)
+			++added;
+	}
+	return added;
+}
+
+const HdPackEntry *HdPackIndex::Find(const HdKey &key) const
+{
+	const auto it = entries_.find(key);
+	return it != entries_.end() ? &it->second : nullptr;
+}
+
+std::optional<HdImage> DecodeWebp(std::span<const uint8_t> data)
+{
+	int width = 0;
+	int height = 0;
+	uint8_t *pixels = WebPDecodeRGBA(data.data(), data.size(), &width, &height);
+	if (pixels == nullptr)
+		return std::nullopt;
+	HdImage image;
+	image.width = width;
+	image.height = height;
+	image.rgba.assign(pixels, pixels + static_cast<size_t>(width) * height * 4);
+	WebPFree(pixels);
+	return image;
+}
+
+std::optional<HdImage> ComposeHdImage(const HdPackEntry &entry, const HdImage &decoded,
+    const HdIndexedFrame &frame, std::span<const uint8_t> alpha1x, std::string *error)
+{
+	if (entry.width != frame.width || entry.height != frame.height) {
+		SetError(error, "manifest size does not match the frame");
+		return std::nullopt;
+	}
+	const int width = frame.width * HdPackScale;
+	const int height = frame.height * HdPackScale;
+	if (decoded.width != entry.bboxWidth || decoded.height != entry.bboxHeight) {
+		SetError(error, "image size does not match its bbox");
+		return std::nullopt;
+	}
+	if (entry.bboxX + entry.bboxWidth > width || entry.bboxY + entry.bboxHeight > height) {
+		SetError(error, "bbox is outside the frame");
+		return std::nullopt;
+	}
+	if (!alpha1x.empty() && alpha1x.size() != frame.pixels.size()) {
+		SetError(error, "alpha mask size does not match the frame");
+		return std::nullopt;
+	}
+
+	// The 1x silhouette, dilated by one pixel.
+	std::vector<uint8_t> allowed(frame.pixels.size(), 0);
+	for (int y = 0; y < frame.height; ++y) {
+		for (int x = 0; x < frame.width; ++x) {
+			if (!frame.IsOpaque(x, y))
+				continue;
+			for (int dy = -1; dy <= 1; ++dy) {
+				for (int dx = -1; dx <= 1; ++dx) {
+					const int nx = x + dx;
+					const int ny = y + dy;
+					if (nx >= 0 && nx < frame.width && ny >= 0 && ny < frame.height)
+						allowed[static_cast<size_t>(ny) * frame.width + nx] = 1;
+				}
+			}
+		}
+	}
+
+	HdImage result;
+	result.width = width;
+	result.height = height;
+	result.rgba.assign(static_cast<size_t>(width) * height * 4, 0);
+	for (int y = 0; y < entry.bboxHeight; ++y) {
+		const int dstY = entry.bboxY + y;
+		for (int x = 0; x < entry.bboxWidth; ++x) {
+			const int dstX = entry.bboxX + x;
+			const size_t src = (static_cast<size_t>(y) * decoded.width + x) * 4;
+			const size_t dst = (static_cast<size_t>(dstY) * width + dstX) * 4;
+			const size_t pixel1x = static_cast<size_t>(dstY / HdPackScale) * frame.width + dstX / HdPackScale;
+			unsigned alpha = allowed[pixel1x] != 0 ? decoded.rgba[src + 3] : 0;
+			if (!alpha1x.empty())
+				alpha = (alpha * alpha1x[pixel1x] + 127) / 255;
+			for (int c = 0; c < 3; ++c)
+				result.rgba[dst + c] = static_cast<uint8_t>((decoded.rgba[src + c] * alpha + 127) / 255);
+			result.rgba[dst + 3] = static_cast<uint8_t>(alpha);
+		}
+	}
+	return result;
+}
+
+std::optional<HdImage> LoadHdImage(const HdPackEntry &entry, const HdIndexedFrame &frame,
+    std::span<const uint8_t> alpha1x, std::string *error)
+{
+	const std::optional<std::vector<uint8_t>> data = ReadWholeFile(entry.path);
+	if (!data) {
+		SetError(error, "cannot read " + entry.path);
+		return std::nullopt;
+	}
+	const std::optional<HdImage> decoded = DecodeWebp(*data);
+	if (!decoded) {
+		SetError(error, "not a WebP image: " + entry.path);
+		return std::nullopt;
+	}
+	return ComposeHdImage(entry, *decoded, frame, alpha1x, error);
+}
+
+} // namespace devilution
