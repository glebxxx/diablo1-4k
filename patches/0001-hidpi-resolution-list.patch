+
+struct ReferenceCase {
+	const char *name;
+	std::vector<Size> displayModes;
+	Size configuredSize;
+	Size defaultSize;
+	bool supportsAnyResolution;
+	Size desktopSize;
+	bool removeSmallResolutions;
+};
+
+std::vector<ReferenceCase> ReferenceCases()
+{
+	const std::vector<Size> fullHdModes {
+		{ 1920, 1080 }, { 1680, 1050 }, { 1600, 900 }, { 1440, 900 }, { 1280, 1024 }, { 1280, 960 },
+		{ 1280, 800 }, { 1280, 720 }, { 1152, 864 }, { 1024, 768 }, { 800, 600 }, { 720, 480 }, { 720, 400 }, { 640, 480 }
+	};
+	// SDL2 on a Retina 5K display at "looks like 2880x1620": modes in window coordinates times 2,
+	// which is what upstream offered (and what this change still offers without upscaling).
+	std::vector<Size> retinaDoubledModes;
+	for (const Size mode : { Size { 2880, 1620 }, Size { 2560, 1440 }, Size { 2304, 1296 }, Size { 2048, 1152 }, Size { 1920, 1080 },
+	         Size { 1600, 900 }, Size { 1280, 720 }, Size { 1024, 768 }, Size { 800, 600 }, Size { 640, 480 } })
+		retinaDoubledModes.emplace_back(mode.width * 2, mode.height * 2);
+
+	return {
+		{ "FullHdMonitor", fullHdModes, { 640, 480 }, { 640, 480 }, true, { 1920, 1080 }, true },
+		{ "FullHdMonitorConfigured1280x720", fullHdModes, { 1280, 720 }, { 640, 480 }, true, { 1920, 1080 }, true },
+		{ "FullHdMonitorNoUpscale", fullHdModes, { 1024, 768 }, { 640, 480 }, false, { 1920, 1080 }, true },
+		{ "RetinaDoubledModes", retinaDoubledModes, { 10240, 5760 }, { 640, 480 }, true, { 2880, 1620 }, true },
+		{ "SingleMode16x9", { { 1920, 1080 } }, { 640, 480 }, { 640, 480 }, true, { 1920, 1080 }, true },
+		{ "SingleModePhone", { { 2400, 1080 } }, { 1280, 720 }, { 640, 480 }, true, { 2400, 1080 }, true },
+		{ "SingleMode16x10", { { 2560, 1600 } }, { 1440, 900 }, { 640, 480 }, true, { 2560, 1600 }, true },
+		{ "SingleModeUltrawide", { { 3440, 1440 } }, { 3440, 1440 }, { 640, 480 }, true, { 3440, 1440 }, true },
+		{ "SingleModeNoUpscale", { { 1920, 1080 } }, { 640, 480 }, { 640, 480 }, false, { 1920, 1080 }, true },
+		{ "NoModes", {}, { 800, 600 }, { 640, 480 }, true, { 1366, 768 }, true },
+		{ "NoModesUnknownDesktop", {}, { 800, 600 }, { 640, 480 }, true, { 0, 0 }, true },
+		{ "PortraitDesktop", { { 1920, 1080 }, { 1280, 720 } }, { 1280, 720 }, { 640, 480 }, true, { 1080, 1920 }, true },
+		{ "SmallScreenKeepsSmallModes", { { 400, 240 }, { 320, 240 } }, { 400, 240 }, { 800, 480 }, true, { 400, 240 }, false },
+		{ "SmallScreenRemovesSmallModes", { { 400, 240 }, { 320, 240 } }, { 400, 240 }, { 800, 480 }, false, { 400, 240 }, true },
+	};
+}
+
+// Without HiDPI output, the list must be exactly the same as before HiDPI support.
+TEST(ResolutionListTest, WithoutHiDpiMatchesReference)
+{
+	for (const ReferenceCase &testCase : ReferenceCases()) {
+		for (const bool fitToScreen : { false, true }) {
+			SCOPED_TRACE(StrCat(testCase.name, fitToScreen ? " fitToScreen" : ""));
+			ResolutionListParams params;
+			params.displayModes = testCase.displayModes;
+			params.configuredSize = testCase.configuredSize;
+			params.defaultSize = testCase.defaultSize;
+			params.desktopSize = testCase.desktopSize;
+			params.supportsAnyResolution = testCase.supportsAnyResolution;
+			params.fitToScreen = fitToScreen;
+			params.removeSmallResolutions = testCase.removeSmallResolutions;
+
+			const ResolutionList expected = ReferenceResolutionList(testCase.displayModes, testCase.configuredSize, testCase.defaultSize,
+			    testCase.supportsAnyResolution, fitToScreen, testCase.desktopSize, testCase.removeSmallResolutions);
+			const ResolutionList actual = BuildResolutionList(params);
+			ASSERT_FALSE(actual.empty());
+			EXPECT_EQ(Sizes(actual), Sizes(expected));
+			EXPECT_EQ(Labels(actual), Labels(expected));
+		}
+	}
+}
+
+// Without a HiDPI output size (e.g. without upscaling), display modes are used as given. On a Retina
+// display they are doubled, which is the list upstream showed with "Fit to Screen" (the bug this change fixes).
+TEST(ResolutionListTest, WithoutHiDpiUsesDisplayModesAsGiven)
+{
+	ResolutionListParams params;
+	for (const Size mode : { Size { 2880, 1620 }, Size { 1920, 1080 }, Size { 1280, 720 } })
+		params.displayModes.emplace_back(mode.width * 2, mode.height * 2);
+	params.configuredSize = { 640, 480 };
+	params.defaultSize = { 640, 480 };
+	params.desktopSize = { 2880, 1620 };
+	params.supportsAnyResolution = true;
+	params.fitToScreen = true;
+	EXPECT_EQ(Labels(BuildResolutionList(params)), (std::vector<std::string> { "3240p", "2160p", "1440p", "480p" }));
+}
