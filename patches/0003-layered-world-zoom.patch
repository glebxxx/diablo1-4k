+		*other.at(x, 0) = static_cast<uint8_t>(x);
+	DrawHalfTransparentRectTo(other, 0, 0, 16, 1);
+	for (int x = 0; x < 16; ++x)
+		EXPECT_EQ(*other.at(x, 0), paletteTransparencyLookup[0][x]);
