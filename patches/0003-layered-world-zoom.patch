+void DrawWorldPattern(const Surface &world)
+{
+	for (int y = 0; y < world.h(); ++y) {
+		for (int x = 0; x < world.w(); ++x) {
+			*world.at(x, y) = static_cast<uint8_t>((x * 7) + (y * 13) + ((x * y) >> 5));
+		}
+	}
+}
