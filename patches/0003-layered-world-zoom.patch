+
+	const std::array<uint8_t, 10> src = { UiKeyTransparent, UiKeyHalf, 0, 128, 255, /* row 2 */ UiKeyHalf, UiKeyTransparent, 3, 77, 77 };
+	const std::array<uint8_t, 10> half = { 9, 77, 5, 5, 5, /* row 2 */ 0, 33, 1, 2, 2 };
+	std::array<uint32_t, 8> dst {};
