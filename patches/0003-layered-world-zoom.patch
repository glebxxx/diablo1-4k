+	EXPECT_EQ(dst[0], 0U);
+	EXPECT_EQ(dst[1], (lut[77] & 0xFFFFFF) | 0x80000000);
+	EXPECT_EQ(dst[2], lut[0] | 0xFF000000);
+	EXPECT_EQ(dst[3], 0U);
+	EXPECT_EQ(dst[4], (lut[0] & 0xFFFFFF) | 0x80000000);
